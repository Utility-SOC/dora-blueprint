{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dora-blueprint capability layer",
  "type": "object",
  "required": ["version", "capabilities"],
  "additionalProperties": false,
  "properties": {
    "version": {"const": 1},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "description", "status"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^CAP-[A-Z]{3,4}-\\d{2}$"},
          "name": {"type": "string", "minLength": 3},
          "description": {"type": "string", "minLength": 10},
          "status": {"enum": ["implemented", "partial", "planned"]},
          "implemented_by": {"type": "array", "items": {"type": "string"}},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "demo": {"type": "string"},
          "roadmap": {"type": "array", "items": {"type": "string"}}
        },
        "allOf": [
          {"if": {"properties": {"status": {"const": "implemented"}}},
           "then": {"required": ["implemented_by"]}},
          {"if": {"properties": {"status": {"const": "planned"}}},
           "then": {"required": ["roadmap"]}}
        ]
      }
    }
  }
}
